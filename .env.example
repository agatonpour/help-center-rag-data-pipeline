# Copy to .env and fill in your own configuration. Never commit .env.
SUPPORT_SITEMAP_URL=https://support.example.com/hc/sitemap.xml
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_HOST=example.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/knowledge-base
SHAREPOINT_DRIVE_NAME=Documents
SHAREPOINT_ROOT_FOLDER=knowledge-base/support
# Azure Blob Storage is required for sync state, including local runs.
AzureWebJobsStorage=
STATE_CONTAINER=sync-state
STATE_BLOB_NAME=support/state_support.json
